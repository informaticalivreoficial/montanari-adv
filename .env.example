APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ----------------------------------------------------------------------------
# Cloudflare R2 (armazenamento de arquivos: documentos, avatars, imagens, etc.)
# Painel R2: https://dash.cloudflare.com/<account_id>/r2
# Crie um "API Token" (R2 Token) com permissão de leitura/escrita no bucket.
# ----------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Opcional: domínio público personalizado (ex.: https://cdn.seu-domínio.com)
# Se o bucket for PRIVADO, deixe em branco — usaremos URLs pré-assinadas.
R2_URL=""
# Subpasta dentro do bucket que será a raiz de todos os arquivos (ex.: "meus-arquivos").
# Deixe em branco para usar a raiz do bucket. Sem barra no início.
R2_ROOT=""
R2_REGION="auto"
R2_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ----------------------------------------------------------------------------
# API Pública do Datajud (CNJ)
# Obtenha a chave pública vigente em:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
# ----------------------------------------------------------------------------
DATAJUD_BASE_URL="https://api-publica.datajud.cnj.jus.br"
DATAJUD_API_KEY=""
DATAJUD_TIMEOUT=30
DATAJUD_RETRIES=2
DATAJUD_RETRY_DELAY=500
DATAJUD_CACHE_ENABLED=true
DATAJUD_CACHE_TTL=3600

# ----------------------------------------------------------------------------
# DJEN - Diário de Justiça Eletrônico Nacional (Comunica / CNJ)
DJEN_BASE_URL="https://comunicaapi.pje.jus.br"
DJEN_TIMEOUT=40
DJEN_RETRIES=2
DJEN_RETRY_DELAY=500
DJEN_CACHE_ENABLED=true
DJEN_CACHE_TTL=86400
DJEN_MAX_PAGES=200
